          "text": "워~ 워~ 워~"
        }
      ]
    },
    {
      "id": "line-09",
      "start": 0,
      "end": 0,
      "breakBefore": true,
      "original": [
        {
          "text": "ウォー　ウォー　ウォー"
        }
